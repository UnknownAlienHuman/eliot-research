# Provisioning/deployment environment. Secrets stay empty; the non-secret browser-OAuth
# operator identity below mirrors the tracked template infra/cloudflare/operator-profile.json
# (fictional placeholders). Real values live only in ignored local state
# (.eliotr-state/cloudflare/operator-profile.json) or explicit env vars.
# No API key is used by this flow: authenticate with `pnpm exec wrangler login`.
ELIOTR_CLOUDFLARE_AUTH_MODE=wrangler-oauth
ELIOTR_WRANGLER_PROFILE=default
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=
ELIOTR_ACCESS_HOSTNAME=eliotr-core.example-subdomain.workers.dev
ELIOTR_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# Leave empty on first deploy: the AUD is Cloudflare-generated on Access create and read back.
ELIOTR_ACCESS_AUDIENCE=
ELIOTR_CUSTOM_DOMAIN=0
# Comma-separated Cloudflare Access service-token Client IDs admitted to the ordinary API.
# Do not add dedicated MCP tokens.
ELIOTR_ACCESS_SERVICE_PRINCIPALS=
ELIOTR_OWNER_EMAILS=operator@example.com

# Dedicated /mcp Access application on the same protected hostname.
ELIOTR_MCP_HOSTNAME=eliotr-core.example-subdomain.workers.dev
ELIOTR_MCP_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
ELIOTR_MCP_ACCESS_AUDIENCE=
ELIOTR_MCP_ACCESS_AUTH_PROFILE=service-token
# Optional enable-only signal; omit when profile/bindings already select MCP. Do not use 0 for removal.
ELIOTR_MCP_ACCESS_ENABLED=1
# Compatible legacy pair (omit both when Spark is unused).
ELIOTR_MCP_ACCESS_SERVICE_TOKEN_ID=
ELIOTR_MCP_ACCESS_SERVICE_TOKEN_CLIENT_ID=
# Additional independent clients: JSON array of {"token_id":"UUID","client_id":"name.access"}.
ELIOTR_MCP_ACCESS_SERVICE_TOKENS=[]

GOOGLE_EXCHANGE_EMAIL=

# Client-side connector credentials; never put real values into tracked files.
ELIOTR_CF_ACCESS_CLIENT_ID=
ELIOTR_CF_ACCESS_CLIENT_SECRET=

# Destructive or billable operations still require the script's explicit --confirm-live gate.
