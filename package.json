{
  "name": "eliot-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src vite.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "cf:types": "wrangler types",
    "cf:dry-run": "pnpm build && wrangler deploy --dry-run --minify --outdir dist/worker"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "5.104.1",
    "agents": "0.30.1",
    "ai": "7.0.152",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.33",
    "@ai-sdk/react": "4.0.156",
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "wrangler": "4.151.3"
  }
}
