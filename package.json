{
  "name": "eliot-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run --config vitest.k0.config.ts",
    "eval": "node scripts/eval/run.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf:types": "wrangler types src/worker-configuration.d.ts --include-runtime false --strict-vars false",
    "cf:dry-run": "pnpm build && wrangler deploy --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "5.104.1",
    "agents": "0.30.1",
    "ai": "7.0.152",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.33",
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
