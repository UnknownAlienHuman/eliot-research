{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliotr.local/schemas/golden-case.v1.json",
  "title": "Eliot Research GoldenCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "source_revision_refs", "scope_expression", "question", "expected_product",
    "required_atoms", "forbidden_collapses", "required_evidence_handle_refs",
    "acceptable_unknowns", "coverage_requirement", "adjudication_notes"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "source_revision_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "scope_expression": { "$ref": "#/$defs/scopeExpression" },
    "question": { "type": "string", "minLength": 1 },
    "expected_product": { "enum": ["FAST_SEARCH", "LOCATE", "ORIENT", "RESEARCH", "EXHAUSTIVE_JOB", "VERIFY_EXACT", "MATERIALIZE"] },
    "required_atoms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "forbidden_collapses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "required_evidence_handle_refs": { "type": "array", "items": { "$ref": "#/$defs/versionedRef" } },
    "acceptable_unknowns": { "type": "array", "items": { "type": "string" } },
    "coverage_requirement": { "enum": ["none", "sampled", "complete_scope"] },
    "adjudication_notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "versionedRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 } }
    },
    "scopeExpression": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "GLOBAL_LIBRARY" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "project_id"], "properties": { "kind": { "const": "PROJECT" }, "project_id": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "source_ids"], "properties": { "kind": { "const": "SELECTED_SOURCES" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "source_class"], "properties": { "kind": { "const": "SOURCE_CLASS" }, "source_class": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "tag"], "properties": { "kind": { "const": "TAG" }, "tag": { "type": "string", "minLength": 1 } } },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "left", "right"],
          "properties": { "kind": { "enum": ["UNION", "INTERSECT", "EXCEPT"] }, "left": { "$ref": "#/$defs/scopeExpression" }, "right": { "$ref": "#/$defs/scopeExpression" } }
        }
      ]
    }
  }
}
