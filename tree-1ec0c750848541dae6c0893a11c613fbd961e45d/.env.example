# Provisioning/deployment environment. Secrets stay empty; the non-secret browser-OAuth
# operator identity below mirrors tracked infra/cloudflare/operator-profile.json.
# No API key is used by this flow: authenticate with `pnpm exec wrangler login` (profile `default`).
ELIOTR_CLOUDFLARE_AUTH_MODE=wrangler-oauth
ELIOTR_WRANGLER_PROFILE=default
CLOUDFLARE_ACCOUNT_ID=bc10e9f02aa57f4adc5a7a48ad1bacff
CLOUDFLARE_API_TOKEN=
ELIOTR_ACCESS_HOSTNAME=eliotr-core.kleymor-metal.workers.dev
ELIOTR_ACCESS_TEAM_DOMAIN=https://iuriilisenkov.cloudflareaccess.com
# Leave empty on first deploy: the AUD is Cloudflare-generated on Access create and read back.
ELIOTR_ACCESS_AUDIENCE=
ELIOTR_CUSTOM_DOMAIN=0
# Comma-separated Cloudflare Access service-token Client IDs admitted to the ordinary API.
# Do not add the dedicated Gemini MCP token.
ELIOTR_ACCESS_SERVICE_PRINCIPALS=
ELIOTR_OWNER_EMAILS=kleymor.metal@gmail.com

# Dedicated MCP hostname and Access application. It must not equal ELIOTR_ACCESS_HOSTNAME.
ELIOTR_MCP_HOSTNAME=mcp.replace-me.example
ELIOTR_MCP_ACCESS_TEAM_DOMAIN=https://replace-me.cloudflareaccess.com
ELIOTR_MCP_ACCESS_AUDIENCE=
# Exact Client ID of the dedicated Access service token, normally ending in .access.
ELIOTR_MCP_ACCESS_SERVICE_TOKEN_CLIENT_ID=

GOOGLE_EXCHANGE_EMAIL=

# Gemini settings reference these client credentials at runtime; never put values into tracked files.
ELIOTR_CF_ACCESS_CLIENT_ID=
ELIOTR_CF_ACCESS_CLIENT_SECRET=

# Destructive or billable operations still require the script's explicit --confirm-live gate.