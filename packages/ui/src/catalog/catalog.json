  "mathematical_layout_allowlist": [
    "0, 1fr, 100percent, auto, minmax(0,1fr), 100dvh",
    "calc(100percent - 2 * panel spacing)",
    "48rem compact and 64rem medium boundaries; 80rem supporting-context minimum",
