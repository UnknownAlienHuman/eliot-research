{
  "protocol": "eliotr.ui-catalog.v1",
  "authority": "packages/ui/src/catalog/catalog.json",
  "import": "@eliotr/ui",
  "foundation": "Native HTML; React19.3.0; one local Material Symbols Outlined family",
  "component_family": "native",
  "components": [
    {
      "id": "material.button",
      "export": "Button",
      "consumer": "Research composer; source review action",
      "variants": [
        "primary",
        "tonal",
        "text"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "pressed",
        "disabled",
        "loading"
      ],
      "props": [
        "variant",
        "icon",
        "loading",
        "className",
        "native button attributes except style and dangerouslySetInnerHTML"
      ],
      "stories": [
        "primitives-native--primary",
        "primitives-native--tonal",
        "primitives-native--text",
        "primitives-native--loading",
        "primitives-native--disabled"
      ]
    },
    {
      "id": "material.icon-button",
      "export": "IconButton",
      "consumer": "Source and evidence details",
      "variants": [],
      "props": [
        "label",
        "icon",
        "className",
        "native button attributes except children, style and dangerouslySetInnerHTML"
      ],
      "stories": [
        "primitives-native--labelled-icon"
      ],
      "focus": "native button, required accessible label"
    },
    {
      "id": "material.field",
      "export": "Field",
      "consumer": "Source title, connection settings",
      "variants": [],
      "props": [
        "label",
        "hint",
        "error",
        "className",
        "native input attributes except style and dangerouslySetInnerHTML"
      ],
      "stories": [
        "primitives-native--field-hint",
        "primitives-native--field-error",
        "primitives-native--long-russian"
      ],
      "relationships": "useId/id label binding; hint/error describedBy; invalid from error"
    },
    {
      "id": "material.status",
      "export": "Status",
      "consumer": "Source readiness and connection observation",
      "variants": [
        "neutral",
        "error"
      ],
      "props": [
        "tone",
        "icon",
        "children: required text"
      ],
      "stories": [
        "primitives-native--neutral-status",
        "primitives-native--error-status"
      ],
      "truth": "Text plus local icon; primary never implies success or confidence"
    },
    {
      "id": "material.dialog",
      "export": "Dialog",
      "consumer": "Explicit source review before action",
      "variants": [],
      "props": [
        "open",
        "title",
        "onClose",
        "children"
      ],
      "stories": [
        "primitives-native--modal-interaction"
      ],
      "focus": "native showModal/cancel; connected opener return; unmount cleanup; StrictMode remount"
    },
    {
      "id": "pattern.sources-fixture",
      "export": "SourcesFixture",
      "consumer": "U2 Sources destination",
      "props": [
        "view",
        "locale",
        "active",
        "sources",
        "selection",
        "onSelection",
        "onOpenSource",
        "onAddSource",
        "children"
      ],
      "states": [
        "useful",
        "loading",
        "empty",
        "degraded",
        "error"
      ],
      "truth": "Explicit synthetic capture, admission and readiness; only future selection changes; historical report scope remains frozen"
    },
    {
      "id": "pattern.research-fixture",
      "export": "ResearchFixture",
      "consumer": "U2 question and sample report",
      "props": [
        "state",
        "locale",
        "scopeCount",
        "noHits",
        "budget",
        "snapshot",
        "onAsk",
        "onToggleSampleReport",
        "onCitation",
        "onRefreshSampleSnapshot",
        "outcomeUnknown"
      ],
      "states": [
        "empty",
        "loading",
        "degraded",
        "error",
        "complete"
      ],
      "truth": "Local sample actions, separate no-hit/budget/snapshot/completion/acceptance; no transcript or provider call"
    },
    {
      "id": "pattern.studio-fixture",
      "export": "StudioFixture",
      "consumer": "U2 saved draft and Wiki proposal",
      "props": [
        "locale",
        "state",
        "copy",
        "reportBody",
        "onOpenReport",
        "onCreateProposal"
      ],
      "states": [
        "useful",
        "loading",
        "empty",
        "degraded",
        "error",
        "cancelled"
      ],
      "truth": "Only saved sample draft and supported Wiki proposal; proposal never implies acceptance/publication"
    },
    {
      "id": "pattern.connections-fixture",
      "export": "ConnectionsFixture",
      "consumer": "U2 independent connection facts",
      "props": [
        "locale",
        "state",
        "rows",
        "diagnostic",
        "onSample",
        "onRecover"
      ],
      "states": [
        "useful",
        "loading",
        "empty",
        "degraded",
        "error"
      ],
      "truth": "Seven independent facts; synthetic observations remain samples, configuration never proves connection"
    }
  ],
  "scenarios": {
    "u2-sources": [
      "product-sources--useful",
