{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eliot-research",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  }
}
