{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliot-research.invalid/schemas/cloudflare/deployment-receipt.schema.json",
  "title": "Eliot Research Cloudflare deployment receipt",
  "description": "v1 protocol unchanged: account_id, access_app_id, access_aud, access_team_domain, access_hostname, access_owner_email_set_sha256, backend_fingerprint and deployment_authority_sync are optional in schema for backward compatibility with pre-existing receipts, but runtime enforces them fail-closed when present bindings or deployment authority drift. New receipts should include them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "deployment_generation",
    "environment",
    "worker",
    "generated_config_sha256",
    "remote_http_smoke",
    "live_conformance",
    "note",
    "created_at"
  ],
  "properties": {
    "protocol": { "const": "eliotr.cloudflare-deployment-receipt.v1" },
    "deployment_generation": { "type": "string", "minLength": 1 },
    "backend_fingerprint": { "$ref": "#/$defs/sha256" },
    "deployment_authority_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "deployment_generation", "backend_fingerprint", "retired_generation", "readback"],
      "properties": {
        "state": { "enum": ["INITIALIZED", "ALREADY_ACTIVE", "ROTATED"] },
        "deployment_generation": { "type": "string", "minLength": 1 },
        "backend_fingerprint": { "$ref": "#/$defs/sha256" },
        "retired_generation": { "type": ["string", "null"] },
        "readback": { "const": "PASS" }
      }
    },
    "d1_migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "streams"
      ],
      "properties": {
        "state": {
          "const": "PASS"
        },
        "streams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "database_id",
              "migration_names",
              "local_migration_bundle_sha256"
            ],
            "properties": {
              "binding": {
                "enum": [
                  "CORE_DB",
                  "SEARCH_DB"
                ]
              },
              "database_id": { "$ref": "#/$defs/uuid" },
              "migration_names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2048,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/migrationName" }
              },
              "local_migration_bundle_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "schema_generation_readback": {
      "description": "Read-only comparison of required schema_generation markers; not a full remote schema attestation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "streams"],
      "properties": {
        "state": { "const": "PASS" },
        "streams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "database_id",
              "required_schema_generation",
              "observed_schema_generation",
              "readback"
            ],
            "properties": {
              "binding": { "enum": ["CORE_DB", "SEARCH_DB"] },
              "database_id": { "$ref": "#/$defs/uuid" },
              "required_schema_generation": { "type": "string", "minLength": 1 },
              "observed_schema_generation": { "type": "string", "minLength": 1 },
              "readback": { "const": "PASS" }
            }
          }
        }
      }
    },
    "application_schema_attestation": {
      "$ref": "#/$defs/applicationSchemaAttestation"
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "readback"
      ],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "directory",
            "files",
            "excluded_routing_files",
            "manifest_sha256"
          ],
          "properties": {
            "protocol": {
              "const": "eliotr.cloudflare-assets-manifest.v1"
            },
            "state": {
              "const": "LOCAL_ONLY"
            },
            "directory": {
              "const": "apps/eliotr-pwa/dist"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16777216
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "excluded_routing_files": {
              "const": [
                "_headers",
                "_redirects"
              ]
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "readback": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "const": "NOT_EXECUTED"
                },
                "reason": {
                  "const": "access_cookie_missing"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "results",
                "deployment_id",
                "version_id",
                "active_version_unchanged"
              ],
              "properties": {
                "state": {
                  "const": "PASS"
                },
                "results": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "status",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                      },
                      "sha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "status": {
                        "const": 200
                      }
                    }
                  }
                },
                "deployment_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "active_version_unchanged": {
                  "const": "PASS"
                }
              }
            }
          ]
        }
      }
    },
    "environment": { "enum": ["staging", "production"] },
    "staging_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "isolation", "target_declaration_sha256", "account_id_sha256"],
      "properties": {
        "protocol": { "const": "eliotr.staging-target-binding.v1" },
        "isolation": { "const": "dedicated-account" },
        "target_declaration_sha256": { "$ref": "#/$defs/sha256" },
        "account_id_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "account_id": { "type": "string", "minLength": 1 },
    "access_app_id": { "type": "string", "minLength": 1 },
    "access_aud": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
    "access_team_domain": {
      "type": "string",
      "pattern": "^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.cloudflareaccess\\.com$"
    },
    "access_hostname": { "type": "string", "minLength": 1 },
    "access_owner_email_set_sha256": { "$ref": "#/$defs/sha256" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "compatibility_date", "modified_on", "last_deployed_from", "has_assets", "durable_object_export"],
      "properties": {
        "id": { "const": "eliotr-core" },
        "compatibility_date": { "type": ["string", "null"] },
        "modified_on": { "type": ["string", "null"] },
        "last_deployed_from": { "type": ["string", "null"] },
        "has_assets": { "type": ["boolean", "null"] },
        "durable_object_export": { "const": "durable-object" },
        "deployment_generation_binding": { "const": "PASS" },
        "vars_readback": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "binding_count"],
          "properties": {
            "state": { "const": "PASS" },
            "binding_count": { "type": "integer", "minimum": 1 }
          }
        },
        "deployment_id": { "type": "string", "format": "uuid" },
        "deployment_created_on": { "type": "string", "format": "date-time" },
        "version_id": { "type": "string", "format": "uuid" },
        "version_number": { "type": "integer", "minimum": 1 },
        "version_etag": { "type": "string", "minLength": 1, "maxLength": 256 },
        "traffic_percentage": { "const": 100 },
        "binding_readback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "identity"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "bucket_name": { "type": "string", "minLength": 1 },
                  "queue_name": { "type": "string", "minLength": 1 },
                  "class_name": { "type": "string", "minLength": 1 },
                  "script_name": { "type": "string", "minLength": 1 },
                  "environment": { "type": ["string", "null"] },
                  "workflow_name": { "type": "string", "minLength": 1 },
                  "dataset": { "type": "string", "minLength": 1 },
                  "namespace": { "type": "string", "minLength": 1 },
                  "instance_name": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "generated_config_sha256": { "$ref": "#/$defs/sha256" },
    "build_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "scope",
        "source_head",
        "persisted_directory",
        "input_manifest",
        "bundle_attestation",
        "entrypoint",
        "generated_config"
      ],
      "properties": {
        "protocol": { "const": "eliotr.deployment-build-evidence.v1" },
        "scope": { "const": "BOUNDED_LOCAL_INTEGRITY" },
        "source_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "persisted_directory": { "$ref": "#/$defs/deploymentBuildEvidenceDirectory" },
        "input_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "manifest_sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^\\.eliotr-state/deployment-build-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/deployment-build-inputs\\.json$" },
            "file_sha256": { "$ref": "#/$defs/sha256" },
            "manifest_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "bundle_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "attestation_sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^\\.eliotr-state/deployment-build-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/deployment-worker-bundle\\.json$" },
            "file_sha256": { "$ref": "#/$defs/sha256" },
            "attestation_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "raw_sha256", "byte_length"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "raw_sha256": { "$ref": "#/$defs/sha256" },
            "byte_length": { "type": "integer", "minimum": 0, "maximum": 33554432 }
          }
        },
        "generated_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "byte_length"],
          "properties": {
            "path": { "const": "apps/eliotr-core/wrangler.deploy.jsonc" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_length": { "type": "integer", "minimum": 0, "maximum": 16777216 }
          }
        },
        "application_schema": {
          "$ref": "#/$defs/applicationSchemaBuildEvidence"
        }
      }
    },
    "remote_http_smoke": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "NOT_EXECUTED" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "results"],
          "properties": {
            "state": { "const": "PASS" },
            "results": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "status"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "status": { "type": "integer", "minimum": 200, "maximum": 299 }
                }
              }
            }
          }
        }
      ]
    },
    "live_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "d1_write_readback",
        "r2_immutable_put_readback",
        "queue_duplicate_delivery",
        "durable_object_hibernation",
        "workflow_retry_resume",
        "ai_search_exact_resolution",
        "google_drive_exchange"
      ],
      "properties": {
        "d1_write_readback": { "$ref": "#/$defs/gateState" },
        "r2_immutable_put_readback": { "$ref": "#/$defs/gateState" },
        "queue_duplicate_delivery": { "$ref": "#/$defs/gateState" },
        "durable_object_hibernation": { "$ref": "#/$defs/gateState" },
        "workflow_retry_resume": { "$ref": "#/$defs/gateState" },
        "ai_search_exact_resolution": { "$ref": "#/$defs/gateState" },
        "google_drive_exchange": { "$ref": "#/$defs/gateState" }
      }
    },
    "note": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gateState": { "enum": ["PASS", "FAIL", "NOT_EXECUTED"] },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
    },
    "migrationName": {
      "type": "string",
      "pattern": "^\\d{4}_[A-Za-z0-9_-]+\\.sql$"
    },
    "deploymentBuildEvidenceDirectory": {
      "type": "string",
      "pattern": "^\\.eliotr-state/deployment-build-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "applicationSchemaExclusions": {
      "const": [
        "SQLite internal schema objects whose names begin with sqlite_ (including automatic indexes)",
        "Cloudflare D1 system migration ledger object named d1_migrations (ASCII case-insensitive)"
      ]
    },
    "applicationSchemaStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "account_id",
        "database_id",
        "database_name",
        "migration_bundle_sha256",
        "object_count",
        "catalogue_sha256"
      ],
      "properties": {
        "binding": { "enum": ["CORE_DB", "SEARCH_DB"] },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "database_id": { "$ref": "#/$defs/uuid" },
        "database_name": { "enum": ["eliotr-core", "eliotr-search"] },
        "migration_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "object_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "catalogue_sha256": { "$ref": "#/$defs/sha256" },
        "migration_entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/applicationSchemaMigrationEntry" }
        }
      }
    },
    "applicationSchemaMigrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/migrationName" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "applicationSchemaAttestationCoreStream": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaStream" },
        {
          "properties": {
            "binding": { "const": "CORE_DB" },
            "database_name": { "const": "eliotr-core" }
          },
          "not": { "required": ["migration_entries"] }
        }
      ]
    },
    "applicationSchemaAttestationSearchStream": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaStream" },
        {
          "properties": {
            "binding": { "const": "SEARCH_DB" },
            "database_name": { "const": "eliotr-search" }
          },
          "not": { "required": ["migration_entries"] }
        }
      ]
    },
    "applicationSchemaAttestation": {
      "description": "Read-only application_schema comparison. Excludes SQLite internals and the D1 migration ledger; digests are integrity pins and do not establish source authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "scope",
        "catalogue_protocol",
        "exclusions",
        "streams"
      ],
      "properties": {
        "protocol": { "const": "eliotr.cloudflare-d1.application-schema-attestation.v1" },
        "state": { "const": "PASS" },
        "scope": { "const": "application_schema" },
        "catalogue_protocol": { "const": "eliotr.cloudflare-d1.application-schema-catalogue.v1" },
        "exclusions": { "$ref": "#/$defs/applicationSchemaExclusions" },
        "streams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/applicationSchemaAttestationCoreStream" },
            { "$ref": "#/$defs/applicationSchemaAttestationSearchStream" }
          ],
          "items": false
        }
      }
    },
    "applicationSchemaBuildCoreStream": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaStream" },
        {
          "required": ["migration_entries"],
          "properties": {
            "binding": { "const": "CORE_DB" },
            "database_name": { "const": "eliotr-core" },
            "object_count": { "minimum": 1 }
          }
        }
      ]
    },
    "applicationSchemaBuildSearchStream": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaStream" },
        {
          "required": ["migration_entries"],
          "properties": {
            "binding": { "const": "SEARCH_DB" },
            "database_name": { "const": "eliotr-search" },
            "object_count": { "minimum": 1 }
          }
        }
      ]
    },
    "applicationSchemaPersistedObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "sha256", "byte_length"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.eliotr-state/deployment-build-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/deployment-application-schema-(?:manifest|provenance)\\.json$"
        },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "applicationSchemaExpectedManifestReference": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaPersistedObjectReference" },
        {
          "properties": {
            "path": { "pattern": "/deployment-application-schema-manifest\\.json$" }
          }
        }
      ]
    },
    "applicationSchemaProvenanceReference": {
      "allOf": [
        { "$ref": "#/$defs/applicationSchemaPersistedObjectReference" },
        {
          "properties": {
            "path": { "pattern": "/deployment-application-schema-provenance\\.json$" }
          }
        }
      ]
    },
    "applicationSchemaBuildEvidence": {
      "description": "Locally persisted bounded integrity evidence. File and source hashes pin bytes only; they are not a signature or source-authority claim.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "scope",
        "exclusions",
        "expected_manifest",
        "provenance",
        "generated_config",
        "streams"
      ],
      "properties": {
        "protocol": { "const": "eliotr.deployment-application-schema-build-evidence.v1" },
        "scope": { "const": "application_schema" },
        "exclusions": { "$ref": "#/$defs/applicationSchemaExclusions" },
        "expected_manifest": { "$ref": "#/$defs/applicationSchemaExpectedManifestReference" },
        "provenance": { "$ref": "#/$defs/applicationSchemaProvenanceReference" },
        "generated_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "byte_length"],
          "properties": {
            "path": { "const": "apps/eliotr-core/wrangler.deploy.jsonc" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 }
          }
        },
        "streams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/applicationSchemaBuildCoreStream" },
            { "$ref": "#/$defs/applicationSchemaBuildSearchStream" }
          ],
          "items": false
        }
      }
    }
  }
}
