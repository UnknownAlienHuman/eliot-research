{
  "name": "@eliotr/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --minify --outdir dist",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "dev": "wrangler dev",
    "cf:types": "wrangler types --env-interface CloudflareEnv src/worker-configuration.d.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --minify --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@eliotr/cloudflare-ai": "workspace:*",
    "@eliotr/cloudflare-erasure": "workspace:*",
    "@eliotr/cloudflare-evidence": "workspace:*",
    "@eliotr/cloudflare-navigation": "workspace:*",
    "@eliotr/cloudflare-projection": "workspace:*",
    "@eliotr/contracts": "workspace:*",
    "@eliotr/domain": "workspace:*",
    "@eliotr/google-drive-exchange": "workspace:*",
    "@eliotr/interfaces": "workspace:*",
    "@eliotr/platform-cloudflare": "workspace:*",
    "@eliotr/policy": "workspace:*",
    "@eliotr/research": "workspace:*",
    "@eliotr/retrieval": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.127.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@cloudflare/vitest-plugin": "1.1.0",
    "vitest": "4.1.10"
  }
}
